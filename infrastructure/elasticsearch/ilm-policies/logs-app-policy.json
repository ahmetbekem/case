{
  "policy": {
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_age": "1d",
            "max_primary_shard_size": "10gb"
          },
          "set_priority": { "priority": 100 }
        }
      },
      "delete": {
        "min_age": "14d",
        "actions": { "delete": {} }
      }
    },
    "_meta": {
      "description": "App logs — debug odaklı kısa 14 gün retention"
    }
  }
}
