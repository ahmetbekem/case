# ─────────────────────────────────────────────────────────────
# Dehasoft Test Projesi — Root environment template
#
# Copy to `.env` and adjust for local dev:
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=testproject
POSTGRES_USER=dehasoft
POSTGRES_PASSWORD=dehasoft_pass
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_PORT=6379

# ── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── Elasticsearch + Kibana ────────────────────────────────────
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_PORT=3000

# ── Cross-service secrets ─────────────────────────────────────
# Generate via: openssl rand -hex 32
BACKEND_PROXY_SECRET=replace_me_with_64_char_hex_secret
