# ─────────────────────────────────────────────────────────────
#  PRODUCTION TEMPLATE — KOPYALA, SECRET'LARI DOLDUR, .env YAP
# ─────────────────────────────────────────────────────────────
#  Bu dosyayı asla doğrudan kullanma:
#    cp .env.production.example .env  + secret'ları üret/doldur
#  scripts/validate-prod-env.sh ile zorunlu alanları kontrol et.
# ─────────────────────────────────────────────────────────────

APP_NAME=Dehasoft

# ⚠️ KRİTİK — production'da MUTLAKA aşağıdaki gibi olmalı.
# APP_DEBUG=true bırakırsan 4xx/5xx response'larında full stack
# trace + Laravel sürümü + dosya yolları sızar (OWASP A05).
APP_ENV=production
APP_DEBUG=false

# php artisan key:generate ile üret
APP_KEY=
APP_TIMEZONE=UTC
APP_URL=https://api.example.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production'da sadece info+ — debug log volume çok büyük
LOG_CHANNEL=stack
LOG_STACK=daily,rabbitmq
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ─── RabbitMQ ───────────────────────────────────────────────
# Internal host (NOT 127.0.0.1)
RABBITMQ_HOST=
RABBITMQ_PORT=5672
# Production credentials — secret manager (Vault/AWS SM/K8s)
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ─── Database ───────────────────────────────────────────────
DB_CONNECTION=pgsql
# Internal host (NOT localhost / 127.0.0.1)
DB_HOST=
DB_PORT=5432
# Production DB name
DB_DATABASE=
# Least-privilege role (DDL OFF, DML ON)
DB_USERNAME=
DB_PASSWORD=

# ─── Cache + Session + Queue ────────────────────────────────
# Production: redis (array driver test-only)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Cookie domain (örn .example.com)
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
# Production object storage
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ─── Redis ──────────────────────────────────────────────────
REDIS_CLIENT=predis
# Internal host (NOT 127.0.0.1)
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# ─── Mail (SMTP) ────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── S3 (file uploads + db backup target) ───────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
# Backup bucket
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Auth ───────────────────────────────────────────────────
# 64 hex char (32 byte). bin2hex(random_bytes(32))
JWT_SECRET=

# ─── BFF Proxy gate ─────────────────────────────────────────
# Frontend BFF + backend ortak shared secret. Production'da
# secret manager'dan inject (Vault, AWS SM, K8s secret).
BACKEND_PROXY_SECRET=

# CORS — virgülle ayrılmış allow-list (sadece production
# frontend domain'leri)
SECURITY_ALLOWED_ORIGINS=https://app.example.com

# ─── L5-Swagger ─────────────────────────────────────────────
# Production'da otomatik regenerate KAPALI (build-time generate)
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_USE_ABSOLUTE_PATH=true
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=false
L5_SWAGGER_UI_DARK_MODE=false
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.0.0
L5_SWAGGER_CONST_HOST=https://api.example.com/api/v1
